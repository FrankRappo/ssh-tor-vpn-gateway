client
dev tun
proto tcp-client

# For direct connection, use your server's public IP
remote YOUR_SERVER_IP 443

# For SSH tunnel connection, use localhost and tunnel port
# remote 127.0.0.1 8443

resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
auth SHA256
cipher AES-128-GCM
verb 3

# Certificate files
# These should match your OpenVPN server's CA and client certificates
# IMPORTANT: The client certificate must have any CN EXCEPT "tor" for direct routing

<ca>
-----BEGIN CERTIFICATE-----
YOUR_CA_CERTIFICATE_HERE
-----END CERTIFICATE-----
</ca>

<cert>
-----BEGIN CERTIFICATE-----
YOUR_CLIENT_CERTIFICATE_HERE
(CN can be anything except "tor", e.g., CN=vpn)
-----END CERTIFICATE-----
</cert>

<key>
-----BEGIN PRIVATE KEY-----
YOUR_CLIENT_PRIVATE_KEY_HERE
-----END PRIVATE KEY-----
</key>

<tls-crypt>
-----BEGIN OpenVPN Static key V1-----
YOUR_TLS_CRYPT_KEY_HERE
-----END OpenVPN Static key V1-----
</tls-crypt>
